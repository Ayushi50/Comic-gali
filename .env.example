# Front-end build-time (Vite) variables. All optional: with none set the site runs fully static.
# Set to "1" to use the /api backend (catalog, auth, submissions, moderation, sync).
VITE_API=
# Public takedown contact shown on /takedown (if the API is on, /api/config overrides it).
VITE_TAKEDOWN_EMAIL=
# Public Turnstile site key (not secret). Backend secret goes in .dev.vars / Pages secrets.
VITE_TURNSTILE_SITE_KEY=
